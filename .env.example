SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Google AI Studio free-tier setup:
AI_API_KEY=your-gemini-api-key
AI_BASE_URL=https://generativelanguage.googleapis.com
AI_MODEL=gemini-3.5-flash-lite
IMAGE_API_KEY=your-image-provider-key
IMAGE_MODEL=gpt-image-1
# Optional Hugging Face provider:
# IMAGE_PROVIDER=huggingface
# HF_TOKEN=hf_your_access_token
# HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers
# Note: hf-inference supports text-to-image models here; exact image editing
# with FLUX.1-Kontext requires a supported provider or dedicated HF endpoint.
ADMIN_EMAILS=admin@example.com
